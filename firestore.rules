rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Identity roles (Owner, Admin) MUST be verified against a trusted source.
      // We use a allowlist of emails but ensure email_verified is true to prevent spoofing.
      return isSignedIn() && 
             request.auth.token.email_verified == true && (
               request.auth.token.email == "dennyancasa@gmail.com" ||
               request.auth.token.email == "dennayncasa@gmail.com" ||
               request.auth.token.email == "dennyan.moto@gmail.com"
             );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isDocOwner() {
      return isSignedIn() && (
        (request.resource != null && request.resource.data.ownerId == request.auth.uid) ||
        (resource != null && resource.data.ownerId == request.auth.uid)
      );
    }

    function uidUnchanged() {
      return incoming().ownerId == request.auth.uid;
    }

    function uidNotModified() {
      return incoming().ownerId == existing().ownerId;
    }

    function hasOnlyAllowedFields(fields) {
      return incoming().keys().hasOnly(fields);
    }

    function isValidDate(field) {
      return !incoming().keys().contains(field) || (
             incoming()[field] is string && 
             incoming()[field].size() <= 64);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProperty(data) {
      let allowed = ['id', 'name', 'address', 'status', 'rentValue', 'paymentDay', 'currentTenantId', 'ownerId', 'createdAt', 'updatedAt', 'thumbnailLink'];
      return incoming().keys().hasAll(['name', 'ownerId']) &&
             incoming().keys().hasOnly(allowed) &&
             data.name is string && data.name.size() > 0 &&
             (!data.keys().contains('status') || data.status in ['vacant', 'rented', 'renovation']) &&
             (!data.keys().contains('rentValue') || data.rentValue is number) &&
             (isAdmin() || data.ownerId == request.auth.uid);
    }

    function isValidTenant(data) {
      let allowed = ['id', 'name', 'cpf', 'contact', 'secondaryContact', 'status', 'rating', 'observations', 'contractFile', 'propertyId', 'ownerId', 'createdAt', 'updatedAt', 'initialPaymentType', 'depositValue', 'depositInstallments', 'depositDay', 'linkedUserId', 'evidenceLocation', 'evidenceName', 'thumbnailLink'];
      return incoming().keys().hasAll(['name', 'ownerId', 'status']) &&
             incoming().keys().hasOnly(allowed) &&
             data.name is string && data.name.size() > 0 &&
             data.status in ['waiting', 'allocated', 'archived'] &&
             (!data.keys().contains('depositInstallments') || data.depositInstallments is number) &&
             (!data.keys().contains('depositDay') || data.depositDay is number) &&
             (isAdmin() || data.ownerId == request.auth.uid);
    }

    function isValidAgreement(data) {
      let allowed = ['id', 'tenantId', 'propertyId', 'description', 'totalAmount', 'installmentAmount', 'durationMonths', 'startDate', 'status', 'justification', 'evidence', 'evidenceName', 'evidenceLocation', 'ownerId', 'createdAt', 'updatedAt', 'thumbnailLink'];
      return incoming().keys().hasAll(['ownerId', 'tenantId', 'description']) &&
             incoming().keys().hasOnly(allowed) &&
             (isAdmin() || data.ownerId == request.auth.uid);
    }

    function isValidExpense(data) {
      let allowed = ['id', 'propertyId', 'description', 'amount', 'date', 'type', 'evidence', 'evidenceName', 'evidenceLocation', 'ownerId', 'createdAt', 'updatedAt', 'thumbnailLink'];
      return incoming().keys().hasAll(['ownerId', 'propertyId', 'amount']) &&
             incoming().keys().hasOnly(allowed) &&
             (isAdmin() || data.ownerId == request.auth.uid);
    }

    function isValidPayment(data) {
      let allowed = ['id', 'propertyId', 'tenantId', 'amount', 'paidAmount', 'dueDate', 'paidDate', 'status', 'interestAmount', 'receiptUrl', 'evidenceName', 'evidenceLocation', 'ownerId', 'createdAt', 'updatedAt', 'type', 'description', 'observations', 'agreementId', 'revertReason', 'thumbnailLink'];
      return incoming().keys().hasAll(['ownerId', 'propertyId', 'amount', 'status']) &&
             incoming().keys().hasOnly(allowed) &&
             (isAdmin() || data.ownerId == request.auth.uid);
    }

    function isValidConfig(data) {
      let allowed = ['securityPassword', 'updatedAt', 'googleDriveTokens', 'googleDriveConnected', 'driveRootFolderId'];
      return incoming().keys().hasOnly(allowed);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /test/connection {
      allow read: if true;
    }

    match /properties/{propertyId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isAdmin()) && isValidProperty(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()) && (incoming().ownerId == existing().ownerId || isAdmin()) && isValidProperty(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /tenants/{tenantId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isAdmin()) && isValidTenant(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()) && (incoming().ownerId == existing().ownerId || isAdmin()) && isValidTenant(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isAdmin()) && isValidExpense(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()) && (incoming().ownerId == existing().ownerId || isAdmin()) && isValidExpense(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /payments/{paymentId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isAdmin()) && isValidPayment(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()) && (incoming().ownerId == existing().ownerId || isAdmin()) && isValidPayment(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /agreements/{agreementId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isAdmin()) && isValidAgreement(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()) && (incoming().ownerId == existing().ownerId || isAdmin()) && isValidAgreement(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /config/{configId} {
      allow read, write: if isSignedIn() && (request.auth.uid == configId || isAdmin());
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
